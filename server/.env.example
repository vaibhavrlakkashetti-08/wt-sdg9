NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
# Leave blank to run the API without database-backed routes during local setup.
# Set this to your local MongoDB or Atlas URI to enable database-backed routes.
MONGODB_URI=
# Generate a random secret of at least 32 characters for production. Do not commit it.
JWT_ACCESS_SECRET=
BCRYPT_ROUNDS=12
AUTH_COOKIE_SAME_SITE=lax
# Production always requires MongoDB. Set true locally to require it during startup too.
REQUIRE_DATABASE=false